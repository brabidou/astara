{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "astara-navy", "name": "Astara Navy", "color": "#1E2D3E" },
				{ "slug": "astara-off-white", "name": "Astara Off-White", "color": "#F7F7F3" },
				{ "slug": "astara-gray", "name": "Astara Gray", "color": "#DDDBCF" },
				{ "slug": "astara-neutral-green", "name": "Astara Neutral Green", "color": "#979586" },
				{ "slug": "astara-bright-orange", "name": "Astara Bright Orange", "color": "#F9703E" },
				{ "slug": "astara-peach", "name": "Astara Peach", "color": "#FF9D78" },
				{ "slug": "gray-1", "name": "Gray 1", "color": "#333333" }
			],
			"custom": false,
			"customDuotone": false,
			"customGradient": false
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "Manrope, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/Manrope-Regular.woff2" ]
						},
						{
							"fontFamily": "Manrope",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/Manrope-Bold.woff2" ]
						}
					]
				},
				{
					"slug": "besley",
					"name": "Besley",
					"fontFamily": "Besley, serif",
					"fontFace": [
						{
							"fontFamily": "Besley",
							"fontWeight": "600",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/Besley-SemiBold.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "nav-copy", "name": "Nav Copy", "size": "16px" },
				{ "slug": "body-copy", "name": "Body Copy", "size": "20px" },
				{ "slug": "button", "name": "Button", "size": "18px" },
				{ "slug": "heading-4", "name": "H4", "size": "24px" },
				{ "slug": "heading-3", "name": "H3", "size": "36px" },
				{ "slug": "heading-2", "name": "H2", "size": "44px" },
				{ "slug": "heading-1", "name": "H1", "size": "90px" },
				{ "slug": "footer-logo", "name": "Footer Logo", "size": "47.822px" },
				{ "slug": "eyebrow", "name": "Eyebrow", "size": "20px" }
			],
			"customFontSize": false
		},
		"spacing": {
			"units": [ "px", "%", "em", "rem", "vw", "vh" ],
			"customSpacingSize": true
		},
		"layout": {
			"contentSize": "1552px",
			"wideSize": "1728px"
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--astara-off-white)",
			"text": "var(--wp--preset--color--gray-1)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "var(--wp--preset--font-size--body-copy)",
			"lineHeight": "1.4"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-1)",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-2)",
					"lineHeight": "1.15"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-3)",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-4)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
