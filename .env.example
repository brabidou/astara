# Copy this file to .env and fill in real values. Never commit .env.

# Figma personal access token, if any tooling needs it outside the MCP connection
FIGMA_ACCESS_TOKEN=

# Link to the Figma design file — canonical page/canvas is "Web design_Rd. 3"
FIGMA_FILE_URL=https://www.figma.com/design/G3xB3i63trCNURnjJBiRJB/Astara--Copy-

# wp-admin credentials used by Playwright tests to log in
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password

# Pressable SSH/SFTP access, used by scripts/*.sh for content sync
# (same credentials as the PRESSABLE_SFTP_* GitHub Actions secrets — see README's Deployment section).
# Local scripts prompt for the password interactively; it is never stored here.
PRESSABLE_SFTP_HOST=
PRESSABLE_SFTP_USER=
PRESSABLE_SFTP_PORT=

# Absolute path to the WordPress root on the server (NOT the theme folder), e.g. /htdocs
PRESSABLE_WP_ROOT=

# The live site URL, used to rewrite URLs when syncing content between environments
PRESSABLE_SITE_URL=
