# Copy this file to .env and fill in real values. Never commit .env.

# Figma personal access token, if any tooling needs it outside the MCP connection
FIGMA_ACCESS_TOKEN=

# Link to the Figma design file
FIGMA_FILE_URL=https://www.figma.com/design/1CosnSdMpN5rqmnHF6eWnH/Astara

# wp-admin credentials used by Playwright tests to log in
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password

# Staging/production database credentials, for deploy or sync scripts only.
# Local dev uses wp-env's own database and does not need these.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=

# Deployment target
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=
